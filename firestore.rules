rules_version = '2';

// Firestore security rules for the Living Art Museum.
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Anyone may look; anyone may add, in the shapes the rooms write and no bigger.
service cloud.firestore {
  match /databases/{database}/documents {

    function d() { return request.resource.data; }
    function str(v, n) { return v is string && v.size() <= n; }
    function list(v, n) { return v is list && v.size() <= n; }

    // ---- Pumpkin: the field of painted pumpkins (added, never edited or removed) ----
    match /pumpkinField/{id} {
      allow read: if true;
      allow create: if d().keys().hasOnly(['title', 't', 'thumb', 'turn', 'v'])
                    && str(d().title, 24) && d().t is number
                    && str(d().thumb, 300000);
      allow update, delete: if false;
    }
    match /pumpkinTex/{id} {
      allow read: if true;
      allow create: if d().keys().hasOnly(['tex', 't'])
                    && str(d().tex, 1000000) && d().t is number;
      allow update, delete: if false;
    }

    // ---- Basquiat: the shared notebook (anyone can stick, write, peel off) ----
    match /basquiatNotebook/{id} {
      allow read: if true;
      allow create, update: if d().p is number && d().p >= 1 && d().p <= 60
                            && d().k in ['st', 'cut', 'tx', 'er', 'dr']
                            && d().t is number
                            && (!('s' in d()) || str(d().s, 240))
                            && (!('pts' in d()) || list(d().pts, 1200))
                            && (!('poly' in d()) || list(d().poly, 400));
      allow delete: if true;
    }
    // things lying on the desk
    match /basquiatDesk/{id} {
      allow read: if true;
      allow create, update: if d().kind in ['st', 'cut'] && d().t is number
                            && (!('poly' in d()) || list(d().poly, 400));
      allow delete: if true;
    }
    // holes cut in the magazine
    match /basquiatHoles/{id} {
      allow read: if true;
      allow create: if d().m is number && list(d().poly, 400) && d().t is number;
      allow update, delete: if false;
    }
    // ---- Shark: how long each visit stood in front of the tank (one number per visit) ----
    match /sharkGaze/{id} {
      allow read: if true;
      allow create: if d().keys().hasOnly(['s', 't']) && d().s is number && d().s >= 0 && d().s <= 86400 && d().t is number;
      allow update: if d().keys().hasOnly(['s', 't']) && d().s is number && d().s <= 86400 && d().t is number
                    && d().s >= resource.data.s;
      allow delete: if false;
    }
    // ---- Paik: visitors on air — a small photo or a 15-frame clip (120×90 JPEGs), added, never edited ----
    match /paikClips/{id} {
      allow read: if true;
      allow create: if d().keys().hasOnly(['k', 'f', 't', 'w', 'h'])
                    && d().k in ['p', 'v'] && d().t is number
                    && d().w == 120 && d().h == 90
                    && d().f is list && d().f.size() >= 1 && d().f.size() <= 16
                    && str(d().f[0], 40000);
      allow update, delete: if false;
    }
    // ---- Pulse Room: one heartbeat per visit (beats a minute, when, and an optional name), added, never edited ----
    match /pulseRoom/{id} {
      allow read: if true;
      allow create: if d().keys().hasOnly(['b', 't', 'n']) && d().b is number && d().b >= 35 && d().b <= 200 && d().t is number
                    && (!('n' in d()) || str(d().n, 16));
      allow update, delete: if false;
    }
    // ---- Swimming Pool: who is by the pool right now (one small doc per open page, removed on leaving) ----
    // used only when the Realtime Database is not set up; Realtime Database is the live server
    match /poolLive/{id} {
      allow read: if true;
      allow create, update: if d().keys().hasOnly(['s', 'x', 'y', 'z', 'r', 'w', 'e', 'et', 'm', 'mt', 'n', 'k', 't', 'f', 'b', 'd'])
                            && d().s in [1, 2] && d().x is number && d().y is number && d().z is number && d().t is number
                            && str(d().n, 16) && (!('m' in d()) || str(d().m, 60)) && (!('e' in d()) || str(d().e, 8))
                            && (!('k' in d()) || list(d().k, 10)) && (!('f' in d()) || str(d().f, 48)) && (!('b' in d()) || str(d().b, 60))
                            && (!('d' in d()) || str(d().d, 4));
      allow delete: if true;
    }
    // ---- Swimming Pool: wish coins on the glass. A private wish is never sent: the server only stores an empty, locked coin ----
    match /poolWishes/{id} {
      allow read: if true;
      allow create: if d().keys().hasOnly(['x', 'z', 'w', 'p', 'n', 't', 's', 'k'])
                    && d().x is number && d().z is number && d().x > -8 && d().x < 8 && d().z > -5.5 && d().z < 5.5
                    && d().p is bool && str(d().w, 60) && str(d().n, 16) && d().t is number
                    && (d().p == false || d().w == '')
                    && (!('s' in d()) || (d().s is number && d().s >= 0 && d().s <= 1500))
                    && (!('k' in d()) || (d().k is int && d().k >= 0 && d().k <= 6));
      allow update, delete: if false;
    }
    // ---- Swimming Pool: the coin toss ranking, one best score per browser ----
    match /poolCoinRank/{id} {
      allow read: if true;
      allow create, update: if d().keys().hasOnly(['n', 's', 'k', 'd', 't'])
                            && str(d().n, 16) && d().s is number && d().s >= 0 && d().s <= 1500
                            && d().k is int && d().k >= 0 && d().k <= 6 && d().d is number && d().t is number;
      allow delete: if false;
    }
    // where the binder, magazine, mug and oilsticks were left
    match /basquiatMeta/{id} {
      allow read: if true;
      allow create, update: if id == 'objs' && d().size() <= 6;
      allow delete: if false;
    }
  }
}
