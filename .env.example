# Copy this file to .env and fill in the values from
# Firebase console → Project settings → Your apps → Web app → SDK setup (Config).
# .env is listed in .gitignore and is never uploaded to GitHub.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
